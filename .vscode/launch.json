{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ascan",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src/ascan",
            "args": [
                "-afgb",
                "-o",
                "M.mk",
                "align.cpp"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/",
            "environment": [],
            "preLaunchTask": "build",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "tlexer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src/tlexer",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/",
            "environment": [],
            "preLaunchTask": "build",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}