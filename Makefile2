PROJECT_ROOT := $(abspath $(dir $(abspath $(lastword $(MAKEFILE_LIST)))))

# PROJECT

PROJECT := ascan

# OPTIONS

CONFIG ?= debug

CXX ?= g++
STD ?= c++17

# DIRECTORIES

# Where to put object files. Must be subdirectory of the project root! Can be set to ".".
BLD_DIR := build
# Where to put the final binary. Must be subdirectory of the project root! Can be set to ".".
BIN_DIR := bin
# Extra parameters to identify the build configuration.
# This is used to create a unique object directory for each build configuration.
EXTRA_PARAMS :=
PARAMS_SIGNATURE := $(shell echo "a$(EXTRA_PARAMS)b" | md5sum | cut -c1-12)
# Where to put object files for each build configuration. Must be subdirectory of the project root!
OBJ_DIR = $(BLD_DIR)/$(CONFIG)/$(CXX).$(STD).$(PARAMS_SIGNATURE)
CONFIG_FILE_EXT := conf

# CHECK DIRECTORIES

# Check that directories do not contain spaces.
SPACE_CHECKS := $(words $(BLD_DIR)) $(words $(OBJ_DIR)) $(words $(BIN_DIR))
ifneq ($(filter-out 1,$(SPACE_CHECKS)),)
$(error "BLD_DIR, OBJ_DIR, BIN_DIR must be set to a directory. Please check your Makefile.")
endif

# Check that directories are subdirectories of the project root.
SUB_DIR_CHECKS := $(shell echo "$(abspath $(BLD_DIR))" | grep -q "^$(PROJECT_ROOT)" || echo 0) \
				 $(shell echo "$(abspath $(OBJ_DIR))" | grep -q "^$(PROJECT_ROOT)" || echo 0) \
				 $(shell echo "$(abspath $(BIN_DIR))" | grep -q "^$(PROJECT_ROOT)" || echo 0)
ifeq ($(filter 0,$(SUB_DIR_CHECKS)),0)
$(error "BLD_DIR, OBJ_DIR, BIN_DIR must be subdirectories of the project root. Please check your Makefile.")
endif

# BUILD DETAILS

CXXFLAGS := -Wall -Wextra -std=$(STD) -I. -I./libs
LDFLAGS := -L./libs -lfmt

ifeq ($(CONFIG),debug)
	CXXFLAGS += -g -O0 -DDEBUG
else ifeq ($(CONFIG),release)
	CXXFLAGS += -flto=4 -O3 -march=native -DNDEBUG
else ifeq ($(CONFIG),test)
	CXXFLAGS += -g -O0 -DTEST -Igoogletest/include
	LDFLAGS += -Lgoogletest/lib -lgtest -lgtest_main -lpthread
endif

default: all

# CONFIGS

# =============================================================================

define ASCAN_CONFIG
target := $(BIN_DIR)/ascan

compiler := $(CXX)
std := $(STD)
compiler_flags := $(CXXFLAGS) -g0
ldflags := $(LDFLAGS)

srcs := src/ascan.cpp 		\
	    src/cfile.cpp 		\
	    src/config.cpp 		\
	    src/mfile.cpp 		\
	    src/mfilev3.cpp 	\
	    src/mfilev4.cpp 	\
	    src/parser.cpp 		\
	    src/settings.cpp 	\
	    src/utils.cpp
endef

# =============================================================================

define OPT_PARSER_CONFIG
target := $(BIN_DIR)/opt_parser

compiler := $(CXX)
std := $(STD)
compiler_flags := $(CXXFLAGS) -g1
ldflags := $(LDFLAGS)

srcs := experiment/opt_parser.cpp
endef

# =============================================================================

OBJS :=
DEPS :=
TARGETS :=

define GEN_VARS
objs := $(foreach src,$(srcs),$(OBJ_DIR)/$(basename $(src)).o)
deps := $$(objs:.o=.d)

# This file is used to store the configuration of the last successful build, so that
# when the configuration changes, we can rebuild the target.
config_file := $(BLD_DIR)/$(notdir $(target))/$(CONFIG).$(compiler).$(std).$(PARAMS_SIGNATURE).$(CONFIG_FILE_EXT)
endef

define REGISTER_CONFIG
$(eval $(call $1,$1))
$(eval $(call GEN_VARS))

OBJS += $(objs)
DEPS += $(deps)
TARGETS += $(target)

-include $(deps)

all: $(target)

$(notdir $(target)): $(target)

$(target): $(objs) $(config_file)
	@mkdir -p $$(@D)
	@echo "$(compiler) $(compiler_flags) ... -o $$@ $(ldflags)"
	@$(compiler) $(compiler_flags) $(objs) -o $$@ $(ldflags)
	$(call CHECK_BUILD_PARAMS)

$(objs): $(OBJ_DIR)/%.o: %.cpp
	@mkdir -p $$(@D)
	$(compiler) $(compiler_flags) -MMD -MP -c $$< -o $$@

$(config_file):
	@mkdir -p $$(@D)
	@rm -f $$(@D)/*.$(CONFIG_FILE_EXT)
	@touch $$@
endef

# =============================================================================

define DEBUG_PRINT_CONFIG
$(info CONFIG_NAME=$1)
$(info compiler_flags=$(compiler_flags))
$(info ldflags=$(ldflags))
$(info target=$(target))
$(info objs=$(objs))
$(info deps=$(deps))
$(info -----------------------------------------------------------------------)
endef

$(eval $(call REGISTER_CONFIG,ASCAN_CONFIG))
$(eval $(call DEBUG_PRINT_CONFIG,ASCAN_CONFIG))

$(eval $(call REGISTER_CONFIG,OPT_PARSER_CONFIG))
$(eval $(call DEBUG_PRINT_CONFIG,OPT_PARSER_CONFIG))

$(info OBJS=$(OBJS))
$(info DEPS=$(DEPS))

debug_print_config:
	@echo "compiler_flags = $(compiler_flags)"
	@echo "ldflags = $(ldflags)"
	@echo "target = $(target)"
	@echo "objs = $(objs)"
	@echo "deps = $(deps)"

# RULES

# PHONY TARGETS

debug:
	@$(MAKE) CONFIG=debug --no-print-directory

release:
	@$(MAKE) CONFIG=release --no-print-directory

test:
	@$(MAKE) CONFIG=test --no-print-directory

clean:
	@echo "Cleaning..."
	@rm -f $(BIN_TARGETS) $(OBJS) $(DEPS) $(BLD_DIR)/*.$(CONFIG_FILE_EXT)

	@#! CAUTION: rm -rf command
	@if [ echo "$(abspath $(BLD_DIR))" | grep -q "^$(PROJECT_ROOT)" ] && \
		[ "$(BLD_DIR)" != "." ] && \
		[ "$(BLD_DIR)" != "/"  ]; then \
		rm -rf "$(BLD_DIR)"; \
	fi

	@#! CAUTION: rm -rf command
	@if [ echo "$(abspath $(BIN_DIR))" | grep -q "^$(PROJECT_ROOT)" ] && \
		[ "$(BIN_DIR)" != "." ] && \
		[ "$(BIN_DIR)" != "/"  ]; then \
		rm -rf "$(BIN_DIR)"; \
	fi

.PHONY: default all debug release test clean

# CHECK BUILD PARAMS

RED		  := $(shell tput setaf 1)
GREEN	  := $(shell tput setaf 2)
YELLOW	  := $(shell tput setaf 3)
BOLD 	  := $(shell tput bold)
UNDERLINE := $(shell tput smul)
RESET	  := $(shell tput sgr0)

define SAVE_BUILD_PARAMS
	@echo "PROJECT=$(PROJECT)" > "$(1)"
	@echo "CONFIG=$(CONFIG)" >> "$(1)"
	@echo "CC=$(CC)" >> "$(1)"
	@echo "CXX=$(CXX)" >> "$(1)"
	@echo "STD=$(STD) $(CSTD) $(CXXSTD)" >> "$(1)"
	@echo "BLD_DIR=$(BLD_DIR)" >> "$(1)"
	@echo "BIN_DIR=$(BIN_DIR)" >> "$(1)"
	@echo "EXTRA_PARAMS=$(EXTRA_PARAMS)" >> "$(1)"
	@echo "OBJ_DIR=$(OBJ_DIR)" >> "$(1)"
	@echo "CONFIG_FILE=$(CONFIG_FILE)" >> "$(1)"
	@echo "CXXFLAGS=$(CXXFLAGS)" >> "$(1)"
	@echo "LDFLAGS=$(LDFLAGS)" >> "$(1)"
endef

define CHECK_BUILD_PARAMS
	$(call SAVE_BUILD_PARAMS,$(OBJ_DIR)/temp.txt)

	@if [ -f $(OBJ_DIR)/build_params.txt ]; then \
		if ! diff -q "$(OBJ_DIR)/build_params.txt" "$(OBJ_DIR)/temp.txt" >/dev/null 2>&1 ; then \
			echo "$(RED)$(BOLD)"; \
			echo -n "WARNING: Build parameters mismatch, most likely due to Makefile changes, or a hash collision, "; \
			echo "you may need a 'make clean'."; \
			echo "$(RESET)"; \
			echo "Diff of build parameters (last vs current):"; \
			diff --ignore-space-change --color --minimal "$(OBJ_DIR)/build_params.txt" "$(OBJ_DIR)/temp.txt"; \
			echo ""; \
		fi \
	fi

	@mv -f "$(OBJ_DIR)/temp.txt" "$(OBJ_DIR)/build_params.txt"
endef
